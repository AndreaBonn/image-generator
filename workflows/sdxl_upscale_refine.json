{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "@checkpoint" },
    "inputs": { "ckpt_name": "juggernautXL_v8Rundiffusion.safetensors" }
  },
  "2": {
    "class_type": "LoraLoader",
    "_meta": { "title": "@lora" },
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "sd_xl_offset_example-lora_1.0.safetensors",
      "strength_model": 0.1,
      "strength_clip": 0.1
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "@prompt_pos" },
    "inputs": { "text": "", "clip": ["2", 1] }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "@prompt_neg" },
    "inputs": { "text": "", "clip": ["2", 1] }
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": { "title": "@input_image" },
    "inputs": { "image": "example.png" }
  },
  "6": {
    "class_type": "UpscaleModelLoader",
    "_meta": { "title": "@upscale_model" },
    "inputs": { "model_name": "4x-UltraSharp.safetensors" }
  },
  "7": {
    "class_type": "ImageUpscaleWithModel",
    "_meta": { "title": "Upscale x4" },
    "inputs": { "upscale_model": ["6", 0], "image": ["5", 0] }
  },
  "8": {
    "class_type": "ImageScale",
    "_meta": { "title": "@resize" },
    "inputs": {
      "image": ["7", 0],
      "upscale_method": "lanczos",
      "width": 2048,
      "height": 2048,
      "crop": "disabled"
    }
  },
  "9": {
    "class_type": "SplitImageToTileList",
    "_meta": { "title": "@tiles" },
    "inputs": { "image": ["8", 0], "tile_width": 1024, "tile_height": 1024, "overlap": 128 }
  },
  "10": {
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE Encode" },
    "inputs": { "pixels": ["9", 0], "vae": ["1", 2] }
  },
  "11": {
    "class_type": "KSampler",
    "_meta": { "title": "@sampler" },
    "inputs": {
      "model": ["2", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["10", 0],
      "seed": 0,
      "steps": 12,
      "cfg": 4.0,
      "sampler_name": "dpmpp_2m_sde_gpu",
      "scheduler": "karras",
      "denoise": 0.3
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["11", 0], "vae": ["1", 2] }
  },
  "13": {
    "class_type": "ImageMergeTileList",
    "_meta": { "title": "@merge" },
    "inputs": { "image_list": ["12", 0], "final_width": 2048, "final_height": 2048, "overlap": 128 }
  },
  "14": {
    "class_type": "SaveImage",
    "_meta": { "title": "@output" },
    "inputs": { "images": ["13", 0], "filename_prefix": "studio/upscale_refine" }
  }
}
