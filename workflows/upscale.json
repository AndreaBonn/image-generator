{
  "1": {
    "class_type": "LoadImage",
    "_meta": { "title": "@input_image" },
    "inputs": { "image": "example.png" }
  },
  "2": {
    "class_type": "UpscaleModelLoader",
    "_meta": { "title": "@upscale_model" },
    "inputs": { "model_name": "4x-UltraSharp.safetensors" }
  },
  "3": {
    "class_type": "ImageUpscaleWithModel",
    "_meta": { "title": "Upscale x4" },
    "inputs": { "upscale_model": ["2", 0], "image": ["1", 0] }
  },
  "4": {
    "class_type": "ImageScaleBy",
    "_meta": { "title": "@scale" },
    "inputs": { "image": ["3", 0], "upscale_method": "lanczos", "scale_by": 0.5 }
  },
  "5": {
    "class_type": "SaveImage",
    "_meta": { "title": "@output" },
    "inputs": { "images": ["4", 0], "filename_prefix": "studio/upscale" }
  }
}
